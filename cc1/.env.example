# PostgreSQL database for Smart CP.
# Keep the real password only in your local environment or untracked .env file.
# DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/smart_cp

DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_cp
DB_USER=postgres
DB_PASSWORD=<PASSWORD>
PORT=5000

# First admin account created by `corepack pnpm run db:setup`.
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=<SET_LOCALLY>
ADMIN_FULL_NAME=Smart CP Admin
ADMIN_EMAIL=admin@smartcp.local
